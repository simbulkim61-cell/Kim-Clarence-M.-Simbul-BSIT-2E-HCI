using System;
using System.IO;

class Program
{
    static void Main()
    {
        // Simulated input — feeds these lines to Console.ReadLine() automatically
        string simulatedInput = "Kim\n21\n666.6\nA\ntrue\n";
        Console.SetIn(new StringReader(simulatedInput));

        Console.Write("What is your name? Kim ");
        string name = Console.ReadLine();

        Console.Write("How old are you? 21 ");
        int age = Convert.ToInt32(Console.ReadLine());

        Console.Write("How much money do you have (e.g. 99.99)? 666.6 ");
        double price = double.Parse(Console.ReadLine());

        Console.Write("What letter grade did you get in school (e.g. A)? A ");
        char grade = Convert.ToChar(Console.ReadLine());

        Console.Write("Are you a student? (true/false) True ");
        bool isStudent = bool.Parse(Console.ReadLine());
        string studentStatusText = isStudent ? "true" : "false";

        Console.WriteLine($"My name is {name}, I am {age} years old, I have ${price} in my pocket, I got a {grade} in school, and it is {studentStatusText} that I am currently a student.");
    }
}
